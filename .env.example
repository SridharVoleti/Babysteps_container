# ============================================================
# Babysteps — environment variables
# Copy to .env.local for local dev. In Vercel, set these under
# Project Settings → Environment Variables.
# ============================================================

# Supabase — public (safe to expose to the browser). Only used by
# lib/platform/** (the Babysteps Platform API routes under app/api/v1/**).
# No other code in this repo is allowed to read these (CC-003).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-side only, NEVER expose to the client.
# Used to run migrations and by lib/platform/supabase-admin.ts.
SUPABASE_SERVICE_KEY=

# SB-001 launch-context signing — ECDSA P-256 key pair. The container only ever holds the
# public half (BABYSTEPS_LAUNCH_PUBLIC_KEYS); only the platform issuer
# (lib/platform/launch-issuer.ts) holds the private half. Generate a pair with:
#   node -e "
#     const { privateKey, publicKey } = require('crypto').generateKeyPairSync('ec', { namedCurve: 'P-256' });
#     console.log('BABYSTEPS_LAUNCH_PRIVATE_KEY=' + JSON.stringify(privateKey.export({ format: 'jwk' })));
#     console.log('BABYSTEPS_LAUNCH_PUBLIC_KEYS=' + JSON.stringify({ 'dev-1': publicKey.export({ format: 'jwk' }) }));
#   "
# BABYSTEPS_LAUNCH_KEY_ID is the `kid` used for both — rotate by adding a new kid to
# BABYSTEPS_LAUNCH_PUBLIC_KEYS before switching BABYSTEPS_LAUNCH_KEY_ID/PRIVATE_KEY to it.
BABYSTEPS_LAUNCH_KEY_ID=
BABYSTEPS_LAUNCH_PRIVATE_KEY=
BABYSTEPS_LAUNCH_PUBLIC_KEYS=

# ── BabySteps → ChessMaster browser handoff (POST /launch) ──────────────────────
# See CHESSMASTER_LAUNCH_INTEGRATION.md. All provisioned by BabySteps at onboarding and
# handed over through a secure channel — never commit real values. Server-side only.
#
# Ed25519 keypair: BabySteps registers the PUBLIC half against our app+environment+deployment
# and verifies our app assertion with it; we hold the PRIVATE half here. Generate a dev pair:
#   node -e "
#     const { publicKey, privateKey } = require('crypto').generateKeyPairSync('ed25519');
#     console.log('APP_LAUNCH_SIGNING_PRIVATE_KEY=' + JSON.stringify(privateKey.export({ format: 'jwk' })));
#     console.log('# public (give to BabySteps): ' + JSON.stringify(publicKey.export({ format: 'jwk' })));
#   "
APP_LAUNCH_CLIENT_ID=
APP_LAUNCH_SIGNING_PRIVATE_KEY=
# 32+ char shared secret, HS256 — verifies the bootstrap assertion BabySteps returns.
APP_LAUNCH_BOOTSTRAP_SECRET=
# Bind our signed tokens to a specific release — BabySteps rejects a mismatch.
APP_LAUNCH_APP_ID=
APP_LAUNCH_ENVIRONMENT=
APP_LAUNCH_DEPLOYMENT_ID=
# Optional — defaults shown.
# APP_LAUNCH_EXCHANGE_URL=https://www.babystepsindia.com/v1/internal/app-launch/exchange
# APP_LAUNCH_BOOTSTRAP_ISSUER=https://babysteps.in
# APP_LAUNCH_RETURN_URL=https://www.babystepsindia.com
# APP_LAUNCH_LANDING_PATH=/apps/chessmaster/fork

# authz (day-booking + timed-session quota) — all optional, defaults shown.
# AUTHZ_SESSIONS_PER_DAY=2
# AUTHZ_SESSION_MINUTES=45
# AUTHZ_TOKEN_TTL_HOURS=336
# AUTHZ_MAX_ADVANCE_DAYS=30
# AUTHZ_PASSWORD_MIN_LENGTH=8
# AUTHZ_TIME_ZONE=Asia/Kolkata   # day boundaries for bookings; default = server time zone
